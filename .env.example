# App (required for Stripe success/cancel URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (stub until connected)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Ian creates Price IDs in Dashboard, sets these in Vercel, then redeploys.
# Never hardcode secret keys. Do not invent live keys.
# Tiers: Starter $49 / Growth $99 / Pro $199 (recurring monthly Price IDs)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# Twilio (stub)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend (stub)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# Vercel AI SDK (stub)
OPENAI_API_KEY=
# or ANTHROPIC_API_KEY=

# Voice — choose one: bland | retell (document choice in README)
VOICE_PROVIDER=bland
BLAND_API_KEY=
RETELL_API_KEY=

# Google Calendar (stub — next steps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Local persistence (default when Supabase unset)
DATA_DIR=./data

# Lead Magnet Engine — live outbound (default off; scaffold never actually sends)
LEAD_MAGNET_LIVE_SEND=false

# Call AI — master gates (default OFF). Never invent keys. Ian arms in Vercel later.
CALL_AI_LIVE=false
CALL_AI_ALLOW_SMS=false
CALL_AI_ALLOW_OUTBOUND=false
CALL_AI_MODE=stub
CALL_AI_DEFAULT_BUSINESS_SLUG=demo-dallas-hvac
CALL_AI_PUBLIC_BASE_URL=
CALL_AI_SCRIPT_PACK=hvac-receptionist-2026-09-06

# Twilio extras (voice webhooks) — empty until armed
TWILIO_VOICE_WEBHOOK_SECRET=
TWILIO_SMS_WEBHOOK_SECRET=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_INBOUND_VOICE_URL=

# Bland extras
BLAND_AGENT_ID=
BLAND_WEBHOOK_SECRET=
BLAND_FROM_NUMBER=

# Retell extras
RETELL_AGENT_ID=
RETELL_WEBHOOK_SECRET=
RETELL_FROM_NUMBER=
